# ===============================
#  Got Mail — environment template
# ===============================
# Copy this file to ".env" and fill in real values. NEVER commit .env.

# -------- Core --------
APP_URL=http://localhost:3000
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-32+-char-random-string

# -------- Database --------
# Dev default: SQLite (zero-config).
DATABASE_URL="file:./prisma/dev.db"
#
# --- Neon Postgres for production (already provisioned: got-mail, US-West-2 Oregon) ---
# Grab your real connection string from console.neon.tech → project "got-mail" → Connect.
# Paste it here (keep it OUT of git — .env is gitignored).
#
# DATABASE_URL="postgresql://neondb_owner:<PASSWORD>@ep-square-firefly-akibved5-pooler.c-3.us-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require&pgbouncer=true"
# DIRECT_URL="postgresql://neondb_owner:<PASSWORD>@ep-square-firefly-akibved5.c-3.us-west-2.aws.neon.tech/neondb?sslmode=require"
#
# Other options: Supabase, Railway, Turso, local Postgres.

# -------- Encryption --------
# Used to encrypt SMTP passwords + API keys at rest.
CREDENTIALS_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# -------- Brevo (ex-Sendinblue) --------
BREVO_API_KEY=
BREVO_WEBHOOK_SECRET=

# -------- Mailjet --------
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_WEBHOOK_SECRET=

# -------- Resend --------
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# -------- Postmark --------
POSTMARK_SERVER_TOKEN=
POSTMARK_WEBHOOK_SECRET=

# -------- SendGrid --------
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_SECRET=

# -------- Amazon SES --------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -------- Postal (self-hosted) --------
POSTAL_BASE_URL=
POSTAL_API_KEY=

# -------- listmonk (self-hosted) --------
LISTMONK_BASE_URL=
LISTMONK_USERNAME=
LISTMONK_PASSWORD=

# -------- Mautic (self-hosted) --------
MAUTIC_BASE_URL=
MAUTIC_USERNAME=
MAUTIC_PASSWORD=

# -------- Default SMTP fallback --------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# -------- Google Workspace (OAuth) --------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -------- AI / Content studio (optional) --------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# -------- Monitoring --------
SENTRY_DSN=
POSTHOG_KEY=

# -------- Feature flags --------
FEATURE_WARMUP_AUTOPILOT=true
FEATURE_DELIVERABILITY_DOCTOR=true
FEATURE_CONSENT_LEDGER=true
FEATURE_AI_CONTENT_STUDIO=false
